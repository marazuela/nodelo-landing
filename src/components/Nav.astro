---
const currentPath = Astro.url.pathname;
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-lg font-bold text-text">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
          <circle cx="16" cy="16" r="14" stroke="#58a6ff" stroke-width="2" />
          <circle cx="16" cy="10" r="3" fill="#58a6ff" />
          <circle cx="10" cy="20" r="3" fill="#bc8cff" />
          <circle cx="22" cy="20" r="3" fill="#bc8cff" />
          <line x1="16" y1="13" x2="10" y2="17" stroke="#30363d" stroke-width="1.5" />
          <line x1="16" y1="13" x2="22" y2="17" stroke="#30363d" stroke-width="1.5" />
          <line x1="10" y1="20" x2="22" y2="20" stroke="#30363d" stroke-width="1.5" />
        </svg>
        Nodelo
      </a>

      <div class="hidden items-center gap-8 md:flex">
        <a
          href="/product"
          class:list={[
            "text-sm transition-colors hover:text-accent",
            currentPath === "/product" ? "text-accent" : "text-muted",
          ]}
        >
          Product
        </a>
        <a
          href="/get-started"
          class:list={[
            "text-sm transition-colors hover:text-accent",
            currentPath === "/get-started" ? "text-accent" : "text-muted",
          ]}
        >
          Docs
        </a>
        <a
          href="https://github.com/marazuela/nodelo"
          target="_blank"
          rel="noopener"
          class="text-sm text-muted transition-colors hover:text-accent"
        >
          GitHub
        </a>
        <a
          href="/get-started"
          class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-bg transition-all hover:brightness-110"
        >
          Get Started
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        class="flex items-center md:hidden"
        aria-label="Toggle menu"
      >
        <svg class="h-6 w-6 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-bg/95 backdrop-blur-lg md:hidden"
  >
    <div class="flex flex-col gap-4 px-6 py-6">
      <a href="/product" class="text-sm text-muted transition-colors hover:text-accent">Product</a>
      <a href="/get-started" class="text-sm text-muted transition-colors hover:text-accent">Docs</a>
      <a href="https://github.com/marazuela/nodelo" target="_blank" rel="noopener" class="text-sm text-muted transition-colors hover:text-accent">GitHub</a>
      <a
        href="/get-started"
        class="rounded-lg bg-accent px-4 py-2 text-center text-sm font-semibold text-bg"
      >
        Get Started
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("main-nav")!;
  const btn = document.getElementById("mobile-menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;

  let menuOpen = false;
  btn.addEventListener("click", () => {
    menuOpen = !menuOpen;
    menu.classList.toggle("hidden", !menuOpen);
  });

  let lastScroll = 0;
  window.addEventListener("scroll", () => {
    const y = window.scrollY;
    if (y > 80) {
      nav.classList.add("bg-bg/80", "backdrop-blur-lg", "border-b", "border-border");
    } else {
      nav.classList.remove("bg-bg/80", "backdrop-blur-lg", "border-b", "border-border");
    }
    lastScroll = y;
  });
</script>
