---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  title="Blog — Nodelo"
  description="Insights on knowledge graphs, AI agents, MCP protocol, and structuring business data for the AI era."
>
  <Nav />

  <main class="pt-28 pb-20">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
      <p class="mt-3 text-muted">
        Insights on knowledge graphs, AI agents, and structuring business data.
      </p>

      <div class="mt-12 space-y-0 divide-y divide-border">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block py-8 first:pt-0 transition-colors"
          >
            <div class="flex flex-wrap items-center gap-3 text-sm text-muted">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {post.data.tags.length > 0 && (
                <>
                  <span class="text-border">&middot;</span>
                  <span>{post.data.tags[0]}</span>
                </>
              )}
            </div>
            <h2 class="mt-2 text-xl font-semibold leading-snug group-hover:text-accent transition-colors">
              {post.data.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-muted line-clamp-2">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <p class="mt-12 text-muted">No posts yet. Check back soon.</p>
      )}
    </div>
  </main>

  <Footer />
</Layout>
