---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nodelo — AI Agents That Know Your Business",
  description = "Nodelo is a knowledge structuring agent that connects to your business systems via MCP and builds a queryable knowledge graph for your AI agents. No engineering required.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />
  </body>
</html>
