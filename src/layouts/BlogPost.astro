---
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  author: string;
  tags: string[];
  image?: string;
  slug: string;
}

const { title, description, date, updated, author, tags, image, slug } = Astro.props;

const canonicalUrl = new URL(`/blog/${slug}`, Astro.site || 'https://nodelo.ai').toString();
const ogImage = image || '/og-image.png';

const wordCount = (await Astro.slots.render('default')).replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 230));

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== slug && p.data.tags.some((t) => tags.includes(t)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: ogImage,
  datePublished: date.toISOString(),
  dateModified: (updated || date).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Solutz',
    url: 'https://nodelo.ai',
  },
  mainEntityOfPage: canonicalUrl,
});
---

<Layout title={`${title} — Nodelo Blog`} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="article:published_time" content={date.toISOString()} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <Nav />

  <main class="pt-28 pb-20">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="transition-colors hover:text-accent">Home</a></li>
          <li class="text-border">/</li>
          <li><a href="/blog" class="transition-colors hover:text-accent">Blog</a></li>
          <li class="text-border">/</li>
          <li class="truncate text-text">{title}</li>
        </ol>
      </nav>

      <article>
        <header class="mb-10">
          <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-muted">
            <time datetime={date.toISOString()}>
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span class="text-border">&middot;</span>
            <span>{readingTime} min read</span>
            {updated && (
              <>
                <span class="text-border">&middot;</span>
                <span>
                  Updated {updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </>
            )}
          </div>
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-5xl">
            {title}
          </h1>
          <p class="mt-4 text-lg text-muted">{description}</p>
          {tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full border border-border px-3 py-0.5 text-xs font-medium text-muted">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <div class="prose">
          <slot />
        </div>
      </article>

      {related.length > 0 && (
        <aside class="mt-20 border-t border-border pt-10">
          <h2 class="mb-6 text-lg font-semibold">Related Articles</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {related.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group rounded-xl border border-border bg-surface p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/30"
              >
                <p class="text-xs text-muted">
                  {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </p>
                <h3 class="mt-2 text-sm font-semibold leading-snug group-hover:text-accent">
                  {post.data.title}
                </h3>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </main>

  <Footer />
</Layout>
